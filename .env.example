# ==============================================================================
# PIPERESQUE PRODUCTION & AUTONOMOUS GROWTH ENGINE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Note: The website builds and operates completely out-of-the-box with sensible
# defaults. The variables below enable optional live external API integrations
# for the daily autonomous growth engine (GitHub Actions / scripts/growth).
# NEVER commit real secret keys or credentials to version control.
# ==============================================================================

# 1. Google Gemini API (Free tier: gemini-3.8-flash for autonomous research & drafting)
# Server-side only. Get key from: https://aistudio.google.com/
GEMINI_API_KEY=""

# 2. Google Search Console API (For daily query, impression, CTR & ranking intelligence)
# Service Account client email and private key (or configure GOOGLE_APPLICATION_CREDENTIALS)
GSC_SITE_URL="https://www.piperesque.com"
GSC_CLIENT_EMAIL="growth-engine@your-project-id.iam.gserviceaccount.com"
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 3. Google Analytics 4 Data API (For visitor engagement & conversion tracking)
# The numeric GA4 Property ID (e.g., 123456789)
GA4_PROPERTY_ID=""

# 4. Autonomous Growth Engine Controls
# Set to 'true' to allow automatic publishing in CI environments; 'false' for manual review
GROWTH_AUTO_PUBLISH="true"
# Minimum editorial quality score required out of 100 (Default: 85)
GROWTH_MIN_QUALITY_SCORE="85"
